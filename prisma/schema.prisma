generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

enum LlmProvider {
  GROQ_DEFAULT
  GROQ_BYOK
  OPENAI_BYOK
  ANTHROPIC_BYOK
  OPENAI_COMPAT_BYOK
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String?
  role           Role        @default(USER)
  trialExpiresAt DateTime?
  isPaid         Boolean     @default(false)
  isDisabled     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tgSessions     TgSession[]
  scrapeJobs     ScrapeJob[]
  chatJobs       ChatJob[]
  aiChatJobs     AIChatJob[]
  apiKeys        UserApiKey[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model TgSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  phone         String?
  sessionString String   @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ScrapeJob {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupEntity   String
  topicId       Int?
  status        JobStatus @default(PENDING)
  csvR2Key      String?
  mediaR2Prefix String?
  // Mirroring every attachment into R2 was the bulk of this service's egress
  // bill, and most jobs only ever consume the CSV text. Opt in per job.
  includeMedia  Boolean   @default(false)
  // Built once on first download and cached here so later downloads are served
  // straight from R2 by presigned URL instead of proxying through this server.
  zipR2Key      String?
  messageCount  Int       @default(0)
  progress      Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model ChatJob {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupEntity   String
  topicId       Int?
  csvR2Key      String?
  mediaR2Prefix String?
  sessionIds    String[]
  intervalMin   Int       @default(3)
  intervalMax   Int       @default(5)
  sendPct       Int       @default(70)
  replyPct      Int       @default(20)
  reactPct      Int       @default(10)
  shouldLoop    Boolean   @default(true)
  status        JobStatus @default(PENDING)
  sentCount     Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model UserApiKey {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     LlmProvider
  encryptedKey String      @db.Text
  baseUrl      String?
  model        String?
  label        String?
  createdAt    DateTime    @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

model AIChatJob {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupEntity       String
  topicId           Int?
  scrapeJobId       String?
  sessionIds        String[]
  provider          LlmProvider @default(GROQ_DEFAULT)
  apiKeyId          String?
  model             String      @default("llama-3.3-70b-versatile")
  detectedLanguage  String?
  personasJson      Json?
  sessionPersonaMap Json?
  intervalMin       Int         @default(8)
  intervalMax       Int         @default(20)
  sendPct           Int         @default(60)
  replyPct          Int         @default(30)
  reactPct          Int         @default(10)
  mediaPct          Int         @default(8)
  contextSize       Int         @default(10)
  maxMessages       Int         @default(200)
  shouldLoop        Boolean     @default(false)
  dryRun            Boolean     @default(false)
  priorityReplyStrangers Boolean @default(false)
  bannedKeywords    String[]
  newsEnabled       Boolean  @default(false)
  newsIntervalMinutes Int    @default(120)
  newsRssUrl        String?
  newsTopicMaxMessages Int   @default(50)
  manualPersonasJson Json?
  autoResurrect     Boolean     @default(false)
  lastResurrectAt   DateTime?
  status            JobStatus   @default(PENDING)
  sentCount         Int         @default(0)
  tokensIn          Int         @default(0)
  tokensOut         Int         @default(0)
  error             String?
  createdAt         DateTime    @default(now())

  @@index([userId])
}
