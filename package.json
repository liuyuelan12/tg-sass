{
  "name": "telegram-master-shixiong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/server.js",
    "start": "node dist/server.js",
    "start:tsx": "tsx server.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "batch-session": "tsx scripts/batch-session.ts",
    "batch-profile": "tsx scripts/batch-profile.ts",
    "create-user": "tsx scripts/create-user.ts",
    "ai-chat": "tsx scripts/ai-chat.ts",
    "superex-refill": "tsx scripts/superex-refill.ts",
    "postinstall": "prisma generate",
    "docs:publish": "bash publish-docs.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.474.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1",
    "telegram": "^2.26.22",
